# Wavo — variables de entorno (copiar a .env.local y completar).
# TODAS son de servidor. Ninguna debe declararse como NEXT_PUBLIC_*.
# Nunca subas .env.local ni claves reales al repositorio.

# --- Stellar (solo Testnet) ---
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Contrato wavo_rewards desplegado (scripts/03-deploy-contract.sh)
WAVO_CONTRACT_ID=
# Stellar Asset Contract del token de pago (XLM nativo en Testnet por defecto)
TOKEN_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
TOKEN_SYMBOL=XLM
TOKEN_DECIMALS=7
# Clave secreta (S...) del admin del contrato. RIESGO: quien la tenga puede ejecutar
# distribute_reward sobre fondos reservados. Usar SOLO una cuenta de Testnet dedicada.
STELLAR_ADMIN_SECRET=

# --- Panel admin ---
# Contraseña del panel /admin (larga y aleatoria)
ADMIN_PASSWORD=
# Secreto HMAC de la cookie de sesión, >= 32 caracteres (p. ej. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=

# --- Supabase (opcional; sin estas variables la app usa el modo demo en memoria, no persistente) ---
SUPABASE_URL=
# Service role key: SOLO servidor. Salta RLS; jamás exponerla al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo ---
# ID de la campaña on-chain (scripts/04-create-and-fund.sh <id>) vinculada a la campaña seed
DEMO_ONCHAIN_CAMPAIGN_ID=3
